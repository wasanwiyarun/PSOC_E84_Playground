# Scoped TF-M build hook: initialize the fixed DSI supply on the secure core.
# No upstream edits and no new non-secure access to protected SRSS registers.
function(logger_tfm_display)
  if(NOT TFM_ISOLATION_LEVEL EQUAL 2)
    message(FATAL_ERROR "Logger flash pause is verified only with TF-M isolation level 2")
  endif()
  target_compile_definitions(tfm_psa_rot_partition_platform PRIVATE IFX_CUSTOM_PLATFORM_HAL_IOCTL=1)
  target_sources(platform_s PRIVATE ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/flash_pause.c)
  # Relocate only our late-used pause loop. Moving vendor delay/GPIO routines
  # would break SystemInit, which runs before the C-runtime copy table.
  set(linker "${CMAKE_BINARY_DIR}/generated/platform/ext/target/infineon/common/toolchain/gcc/tfm_common_s.ld")
  file(READ "${linker}" layout)
  string(FIND "${layout}" "KEEP(*(.ramfunc))" original_ram)
  string(FIND "${layout}" "KEEP(*(.logger_ram))" logger_ram)
  if(original_ram LESS 0 AND logger_ram LESS 0)
    message(FATAL_ERROR "TF-M SRAM linker template changed; review logger flash pause relocation")
  endif()
  if(NOT original_ram LESS 0)
    foreach(selector "*libflash_drivers*:(SORT_BY_ALIGNMENT(.text*))"
                     "*libflash_drivers*:(SORT_BY_ALIGNMENT(.rodata*))")
      string(FIND "${layout}" "${selector}" found)
      if(found LESS 0)
        message(FATAL_ERROR "TF-M flash-driver linker layout changed; review logger relocation")
      endif()
    endforeach()
  endif()
  string(REPLACE "*libflash_drivers*:(SORT_BY_ALIGNMENT(.text*))" "" layout "${layout}")
  string(REPLACE "*libflash_drivers*:(SORT_BY_ALIGNMENT(.rodata*))" "" layout "${layout}")
  string(REPLACE "KEEP(*(.ramfunc))" "KEEP(*(.logger_ram))" layout "${layout}")
  file(WRITE "${linker}" "${layout}")
  target_sources(ifx_bsp PRIVATE ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/display_power.c)
  target_link_options(tfm_s PRIVATE -Wl,--wrap=cybsp_init)
  # DC scanout needs wait-state responses while its AXI access gate changes.
  # Keep security violations as errors. Patch the configuration, not the API,
  # so TF-M's optional FIH readback checks see the same intended values.
  set(source "${CMAKE_SOURCE_DIR}/platform/ext/target/infineon/common/spe/protection/protection_data_common.c")
  file(READ "${source}" original)
  set(old "{.bus_master = APP_AXI_MS3_MSC,\n     .gate_resp = CY_MS_CTL_GATE_RESP_ERR,")
  string(FIND "${original}" "${old}" match)
  if(match LESS 0)
    message(FATAL_ERROR "TF-M MSC configuration changed; review logger DC access-gate fix")
  endif()
  string(REPLACE "${old}" "{.bus_master = APP_AXI_MS3_MSC,\n     .gate_resp = CY_MS_CTL_GATE_RESP_WAITED_TRFR," fixed "${original}")
  set(generated "${CMAKE_BINARY_DIR}/logger_msc_config.c")
  file(WRITE "${generated}" "${fixed}")
  get_target_property(sources tfm_spm SOURCES)
  list(FILTER sources EXCLUDE REGEX "protection_data_common\\.c$")
  set_property(TARGET tfm_spm PROPERTY SOURCES "${sources}")
  target_sources(tfm_spm PRIVATE "${generated}")
endfunction()
if(CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  cmake_language(DEFER CALL logger_tfm_display)
endif()
